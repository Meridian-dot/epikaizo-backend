# Copy this file to .env.local (never commit .env.local).

# Where the API runs. The dashboard forwards /api/* to this address.
API_URL=http://localhost:4000

# "true" = use the pretend data in lib/admin-mock-data.ts (no API needed).
# "false" = use the real API and database. Mock login: any username from the mock data, password "password123".
NEXT_PUBLIC_USE_MOCKS=false
