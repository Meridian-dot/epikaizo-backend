# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# Matches docker-compose.yml in the repo root.
DATABASE_URL=postgresql://epikaizo:epikaizo@localhost:5432/epikaizo
# Sites allowed to call the API (comma-separated). The Next.js dev server runs on 3000.
CORS_ORIGIN=http://localhost:3000
