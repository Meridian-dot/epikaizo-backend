# Copy this file to .env (never commit .env).

# PostgreSQL connection. This matches docker-compose.yml.
# If you use PostgreSQL installed on Windows instead, create the same user and
# database (see README) and keep this line.
DATABASE_URL=postgres://epikaizo:epikaizo@localhost:5432/epikaizo

PORT=4000

# Sites allowed to call the API from the browser, comma-separated.
# 3000 = public website, 3001 = admin dashboard (web/).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# DEV ONLY. Password given to the "admin" login by `npm run db:seed`.
# Not a real secret. Use a long random password on staging, and never seed production.
ADMIN_SEED_PASSWORD=epikaizo-dev-only
